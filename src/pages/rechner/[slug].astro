---
import Layout from "../../layouts/Layout.astro";
import PercentageCalculator from "../../components/PercentageCalculator.astro";
import VatCalculator from "../../components/VatCalculator.astro";
import { calculators } from "../../data/calculators";
import RuleOfThreeCalculator from "../../components/RuleOfThreeCalculator.astro";
import InterestCalculator from "../../components/InterestCalculator.astro";
import DiscountCalculator from "../../components/DiscountCalculator.astro";
import AverageCalculator from "../../components/AverageCalculator.astro";
import FractionCalculator from "../../components/FractionCalculator.astro";
import AgeCalculator from "../../components/AgeCalculator.astro";

export function getStaticPaths() {
  return calculators.map((calculator) => ({
    params: {
      slug: calculator.slug,
    },
    props: {
      calculator,
    },
  }));
}

const { calculator } = Astro.props;

const title = `${calculator.name} | Rechnero`;

const description =
  calculator.seoDescription;
---

<Layout title={title} description={description}>
  <div class="container">
    <section class="hero">
      <p>Rechnero · Rechner</p>

      <h1>{calculator.name}</h1>

      <p>
        {calculator.description}
      </p>
    </section>

    <section>
     {
  calculator.id === "percentage" ? (
    <PercentageCalculator />
  ) : calculator.id === "vat" ? (
    <VatCalculator />
  ) : calculator.id === "rule-of-three" ? (
    <RuleOfThreeCalculator />
  ) : calculator.id === "interest" ? (
    <InterestCalculator />
  ) : calculator.id === "discount" ? (
    <DiscountCalculator />
  ) : calculator.id === "average" ? (
    <AverageCalculator />
  ) : calculator.id === "fraction" ? (
    <FractionCalculator />
  ) : calculator.id === "age" ? (
    <AgeCalculator />
) : null
  
}
    </section>

    <section class="content">
      <h2>{calculator.name}</h2>

      <p>
        {calculator.intro}
      </p>
    </section>
  </div>
</Layout>