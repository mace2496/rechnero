---
import Layout from "../layouts/Layout.astro";
import { converters } from "../data/converters";

const title =
  "Rechnero – Kostenlose Rechner & Umrechner";

const description =
  "Kostenlose Rechner und Umrechner für den Alltag.";
---

<Layout title={title} description={description}>
  <div class="container">
    <section class="hero">
      <p>Rechnero</p>

      <h1>Kostenlose Rechner & Umrechner</h1>

      <p>
        Praktische Rechner und Umrechner für den Alltag –
        schnell, kostenlos und einfach zu bedienen.
      </p>
    </section>

    <section class="content">
      <h2>Umrechner</h2>

      <div class="tool-list">
  {
    converters.map((converter) => (
      <a
        href={`/umrechner/${converter.slug}/`}
        class="tool-card"
      >
        <h3>{converter.name}</h3>

        <p>{converter.description}</p>
      </a>
    ))
  }
</div>
    </section>
  </div>
</Layout>