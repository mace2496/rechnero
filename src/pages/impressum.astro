
---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Impressum | Rechnero"
  description="Impressum und Anbieterinformationen von Rechnero."
>
  <div class="container">
    <section class="hero">
      <p>Rechnero · Rechtliches</p>
      <h1>Impressum</h1>
      <p>Angaben zum Betreiber dieser Website.</p>
    </section>

    <section class="content">
      <h2>Angaben gemäß § 5 DDG</h2>

      <p>
        <strong>[Vorname Nachname]</strong><br />
        [Straße und Hausnummer]<br />
        [Postleitzahl und Ort]<br />
        Deutschland
      </p>

      <h2>Kontakt</h2>
      <p>
        E-Mail: [Deine E-Mail-Adresse]
      </p>

      <p>
        Bitte ersetze alle Platzhalter vor der Veröffentlichung
        durch deine tatsächlichen Angaben.
      </p>
    </section>
  </div>
</Layout>
