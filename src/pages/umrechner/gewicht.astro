---
import Layout from "../../layouts/Layout.astro";
import Converter from "../../components/Converter.astro";
import { weightConverter } from "../../data/converters/weight";

const title =
  "Gewichtsumrechner – Gewicht online umrechnen | Rechnero";

const description =
  "Mit dem kostenlosen Gewichtsumrechner von Rechnero kannst du Milligramm, Gramm, Kilogramm, Tonnen, Unzen und Pfund schnell umrechnen.";
---

<Layout title={title} description={description}>
  <div class="container">
    <section class="hero">
      <p>Rechnero · Umrechner</p>

      <h1>Gewichtsumrechner</h1>

      <p>
        Gewichte schnell und kostenlos zwischen
        verschiedenen Maßeinheiten umrechnen.
      </p>
    </section>

    <section>
      <Converter converter={weightConverter} />
    </section>

    <section class="content">
      <h2>Gewichtseinheiten umrechnen</h2>

      <p>
        Mit unserem Gewichtsumrechner kannst du Werte
        zwischen Milligramm, Gramm, Kilogramm, Tonnen,
        Unzen und Pfund umrechnen.
      </p>

      <h2>Häufige Umrechnungen</h2>

      <ul>
        <li>1 Kilogramm = 1.000 Gramm</li>
        <li>1 Tonne = 1.000 Kilogramm</li>
        <li>1 Pfund = 453,59237 Gramm</li>
        <li>1 Unze = 28,349523125 Gramm</li>
      </ul>
    </section>
  </div>
</Layout>