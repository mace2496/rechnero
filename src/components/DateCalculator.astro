<div class="calculator" data-date-calculator>
  <div class="calculator-section">
    <h3>Datumsdifferenz berechnen</h3>

    <div class="calculator-grid">
      <div class="field">
        <label for="date-start">
          Startdatum
        </label>

        <input
          id="date-start"
          data-start-date
          type="date"
        />
      </div>

      <div class="field">
        <label for="date-end">
          Enddatum
        </label>

        <input
          id="date-end"
          data-end-date
          type="date"
        />
      </div>
    </div>

    <div class="vat-results">
      <div class="vat-result">
        <span>Zeitraum</span>
        <strong data-period>–</strong>
      </div>

      <div class="vat-result">
        <span>Tage insgesamt</span>
        <strong data-days>–</strong>
      </div>
    </div>
  </div>
</div>

<p class="calculator-help">
  Der Rechner ermittelt die Zeitspanne zwischen zwei Daten
  in Jahren, Monaten und Tagen sowie die Anzahl der Tage insgesamt.
</p>

<script>
  const root = document.querySelector(
    "[data-date-calculator]"
  );

  if (root instanceof HTMLElement) {
    const startInput =
      root.querySelector("[data-start-date]");

    const endInput =
      root.querySelector("[data-end-date]");

    const periodResult =
      root.querySelector("[data-period]");

    const daysResult =
      root.querySelector("[data-days]");

    function parseDate(value) {
      const parts = value.split("-").map(Number);

      if (parts.length !== 3) {
        return null;
      }

      const [year, month, day] = parts;

      if (
        !Number.isInteger(year) ||
        !Number.isInteger(month) ||
        !Number.isInteger(day)
      ) {
        return null;
      }

      return new Date(
        Date.UTC(year, month - 1, day)
      );
    }

    function calculate() {
      const startDate =
        parseDate(startInput.value);

      const endDate =
        parseDate(endInput.value);

      if (!startDate || !endDate) {
        periodResult.textContent = "–";
        daysResult.textContent = "–";
        return;
      }

      if (endDate < startDate) {
        periodResult.textContent =
          "Enddatum liegt vor Startdatum";

        daysResult.textContent = "–";
        return;
      }

      let years =
        endDate.getUTCFullYear() -
        startDate.getUTCFullYear();

      let months =
        endDate.getUTCMonth() -
        startDate.getUTCMonth();

      let days =
        endDate.getUTCDate() -
        startDate.getUTCDate();

      if (days < 0) {
        months--;

        const previousMonth =
          new Date(
            Date.UTC(
              endDate.getUTCFullYear(),
              endDate.getUTCMonth(),
              0
            )
          );

        days +=
          previousMonth.getUTCDate();
      }

      if (months < 0) {
        years--;
        months += 12;
      }

      const millisecondsPerDay =
        24 * 60 * 60 * 1000;

      const totalDays =
        Math.floor(
          (endDate.getTime() -
            startDate.getTime()) /
            millisecondsPerDay
        );

      periodResult.textContent =
        `${years} Jahre, ${months} Monate, ${days} Tage`;

      daysResult.textContent =
        new Intl.NumberFormat("de-DE").format(
          totalDays
        );
    }

    startInput.addEventListener(
      "input",
      calculate
    );

    endInput.addEventListener(
      "input",
      calculate
    );

    calculate();
  }
</script>